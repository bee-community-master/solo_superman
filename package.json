{
  "name": "solo-superman-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Technical preview workspace for Solo Superman local-first founder planning.",
  "type": "module",
  "packageManager": "pnpm@11.0.4",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev-with-local-token.mjs",
    "dev:sidecar": "pnpm --filter @solo-superman/sidecar dev",
    "build": "pnpm -r --if-present build",
    "db:generate": "pnpm --filter @solo-superman/db db:generate",
    "db:migrate": "pnpm --filter @solo-superman/db db:migrate",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --passWithNoTests --no-file-parallelism",
    "smoke:e2e": "vitest run e2e --passWithNoTests",
    "verify:prod-bundle": "node scripts/verify-prod-bundle.mjs",
    "verify:codex-live-runtime": "node scripts/verify-codex-live-runtime.mjs",
    "verify:runtime-preview-turn": "tsx apps/sidecar/src/runtime-preview-smoke.ts",
    "verify:worker-job": "tsx apps/sidecar/src/auto-implementation-worker-smoke.ts",
    "verify:pr-mutation": "tsx apps/sidecar/src/auto-implementation-pr-mutation-smoke.ts",
    "verify:auto-implementation-pipeline": "tsx apps/sidecar/src/auto-implementation-pipeline-smoke.ts",
    "verify:docs": "node scripts/verify-doc-contracts.mjs",
    "verify:release-channel": "node scripts/verify-release-channel.mjs",
    "verify:windows-real-device": "node scripts/verify-windows-real-device.mjs",
    "verify:packaged-update-rollback": "node scripts/verify-packaged-update-rollback.mjs",
    "verify:signed-package-preflight": "node scripts/verify-signed-package-preflight.mjs",
    "verify:release-readiness": "node scripts/verify-release-readiness.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm verify:docs && pnpm verify:release-channel && pnpm verify:windows-real-device && pnpm verify:packaged-update-rollback && pnpm verify:signed-package-preflight && pnpm verify:release-readiness && pnpm verify:prod-bundle && pnpm verify:clarification-pipeline && pnpm verify:clarification-volume && pnpm verify:research-pipeline && pnpm verify:browser-delegation-pipeline && pnpm verify:service-page-pipeline && pnpm verify:auto-implementation-pipeline",
    "dev:web": "pnpm --filter @solo-superman/web dev",
    "start:local": "node scripts/start-local-web.mjs",
    "verify:research-pipeline": "tsx apps/sidecar/src/research-pipeline-smoke.ts",
    "verify:clarification-pipeline": "tsx apps/sidecar/src/clarification-pipeline-smoke.ts",
    "verify:auto-implementation-review-loop": "tsx apps/sidecar/src/auto-implementation-review-loop-smoke.ts",
    "verify:browser-delegation-pipeline": "tsx apps/sidecar/src/browser-delegation-pipeline-smoke.ts",
    "verify:service-page-pipeline": "tsx apps/sidecar/src/service-page-pipeline-smoke.ts",
    "verify:clarification-volume": "tsx apps/sidecar/src/clarification-volume-smoke.ts",
    "support:bundle": "node scripts/support-bundle.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  }
}
